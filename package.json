{
  "name": "basic-russian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "web-vitals": "^3.5.2"
  },
  "overrides": {
    "serialize-javascript": "^7.1.4",
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
